        },
        "id": "d4f9f0b8-0c57-4b0e-9ab3-b9443a80d104",
        "name": "CTX | Weekly Cadence",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          140
        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH gate AS (\n  SELECT governance.acquire_runtime_gate('scheduled_intelligence') AS reliability_gate\n)\nSELECT CASE\n  WHEN (reliability_gate->>'allowed')::boolean\n    THEN governance.build_scheduled_intelligence($1,$2::timestamptz)\n  ELSE jsonb_build_object(\n    'status','skipped',\n    'cadence',$1,\n    'as_of',$2::timestamptz,\n    'reason','CIRCUIT_OPEN',\n    'retry_after',reliability_gate->>'retry_after'\n  )\nEND AS intelligence\nFROM gate;",
          "options": {
            "queryReplacement": "={{ [ $json.cadence, $json.scheduled_at ] }}"
          }
        },
        "id": "e5f9f0b8-0c57-4b0e-9ab3-b9443a80d105",
        "name": "DB | Build Scheduled Intelligence",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          500,
          20
        ],
        "credentials": {
          "postgres": {
            "id": "REVINTPGREPORTRO001",
            "name": "REVINT | Reporting RO"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 2000
      },
      {
        "parameters": {
          "jsCode": "const raw = $json.intelligence;\nconst intelligence = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst cadence = String(intelligence?.cadence ?? 'unknown').toLowerCase();\nconst status = intelligence?.status === 'generated' ? 'generated' : 'skipped';\nconst asOf = new Date(intelligence?.as_of ?? Date.now());\nconst day = Number.isNaN(asOf.getTime())\n  ? new Date().toISOString().slice(0, 10)\n  : asOf.toISOString().slice(0, 10);\n\nreturn {\n  event_id: 'SCHED-' + cadence.toUpperCase() + '-' + day + '-' + status.toUpperCase(),\n  event_type: 'scheduled_intelligence_' + status,\n  reliability_component:\n    status === 'generated'\n      ? 'scheduled_intelligence'\n      : null,\n  intelligence\n};"
        },
        "id": "f6f9f0b8-0c57-4b0e-9ab3-b9443a80d106",
        "name": "REP | Prepare Intelligence Event",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          760,
          20
        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT governance.record_reliable_audit_event(\n  $1,NULL,NULL,$2,'scheduled_intelligence',\n  'n8n_scheduled_intelligence',$3::jsonb,$4\n) AS audit_result;",
          "options": {
            "queryReplacement": "={{ [ $json.event_id, $json.event_type, JSON.stringify($json.intelligence), $json.reliability_component ] }}"
          }
        },
        "id": "g7f9f0b8-0c57-4b0e-9ab3-b9443a80d107",
        "name": "AUD | Record Scheduled Intelligence",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
