server {
    listen 127.0.0.1:8081;
    server_name _;

    server_tokens off;
    access_log off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}

server {
    listen 8080;
    server_name ${PUBLIC_DOMAIN};

    server_tokens off;

    if ($host != "${PUBLIC_DOMAIN}") {
        return 404;
    }

    location / {
        return 308 ${PUBLIC_HTTPS_ORIGIN}$request_uri;
    }
}

server {
    listen 8443 ssl;
    server_name ${PUBLIC_DOMAIN};

    server_tokens off;

    if ($host != "${PUBLIC_DOMAIN}") {
        return 404;
    }

    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    client_max_body_size 128k;

    resolver 127.0.0.11 valid=30s ipv6=off;
    set $oauth2_proxy_upstream http://oauth2-proxy:4180;
    set $sso_enabled ${SSO_ENABLED};

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control "no-store" always;

    location /oauth2/ {
        if ($sso_enabled != true) {
            return 404;
        }

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Auth-Request-Redirect $scheme://$host$request_uri;
        proxy_pass $oauth2_proxy_upstream;
    }

    location = /_sso_auth {
        internal;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
        proxy_pass $oauth2_proxy_upstream/oauth2/auth;
    }

    location = /sso/report {
        if ($sso_enabled != true) {
            return 404;
        }

        if ($request_method != POST) {
            return 405;
        }

        auth_request /_sso_auth;
        auth_request_set $sso_subject $upstream_http_x_auth_request_user;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Revint-Sso-Provider "${SSO_IDENTITY_PROVIDER_KEY}";
        proxy_set_header X-Revint-Sso-Subject $sso_subject;
        proxy_set_header X-Revint-Sso-Internal-Key "${SSO_INTERNAL_API_KEY}";
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://n8n:5678/webhook/revint/v2/report-sso;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /webhook/revint/v2/deals {
        if ($request_method != POST) {
            return 405;
        }

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://n8n:5678;
    }

    location = /webhook/revint/v2/report {
        if ($request_method != POST) {
            return 405;
        }

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://n8n:5678;
    }

    location / {
        return 404;
    }
}
