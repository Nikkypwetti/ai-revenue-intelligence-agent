# Revenue Intelligence Agent v2 — Stage 1 deployment example
# Copy this file to deploy/.env and replace every CHANGE_ME value.
# Never commit deploy/.env.

COMPOSE_PROJECT_NAME=revint-agent

# Pinned runtime versions
N8N_VERSION=2.35.7
POSTGRES_VERSION=16-alpine

# n8n application database
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# n8n credential encryption
# Generate a stable random key and keep it backed up securely.
# Changing this key later can make stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME_USE_A_LONG_RANDOM_ENCRYPTION_KEY

# Reporting database administrator
# Stage 2 will add dedicated least-privilege runtime roles.
REPORTING_DB_NAME=revenue_reporting
REPORTING_DB_ADMIN_USER=revint_admin
REPORTING_DB_ADMIN_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Local-only Stage 1 access.
# Production internet exposure will be added only after HTTPS and access controls.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# Client-specific timezone will move to the business configuration layer.
GENERIC_TIMEZONE=Etc/UTC
TZ=Etc/UTC

# Execution retention in hours (14 days by default).
EXECUTIONS_DATA_MAX_AGE=336


# Stage 2 least-privilege runtime credentials
REPORTING_DB_READER_USER=revint_agent_reader
REPORTING_DB_READER_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_READER_PASSWORD
AUDIT_DB_WRITER_USER=revint_audit_writer
AUDIT_DB_WRITER_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_AUDIT_PASSWORD

# Stage 2 client business configuration
CLIENT_COMPANY_NAME="CHANGE_ME_CLIENT_NAME"
CLIENT_TIMEZONE=Etc/UTC
CLIENT_CURRENCY=USD
CLIENT_FISCAL_YEAR_START_MONTH=1
CLIENT_STALE_DEAL_DAYS=14
CLIENT_MIN_PIPELINE_COVERAGE=3.0

# Stage 3 least-privilege connector ingestion credential
# This login may execute only the controlled canonical ingestion gateway.
CONNECTOR_DB_WRITER_USER=revint_connector_writer
CONNECTOR_DB_WRITER_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_CONNECTOR_PASSWORD

# Stage 4 authenticated REST ingestion
# Header name is X-Revint-Ingest-Key. Keep the value private.
REST_INGEST_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_INGESTION_KEY
