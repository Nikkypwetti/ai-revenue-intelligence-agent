# Revenue Intelligence Agent v2 — Stage 1 deployment example
# Copy this file to deploy/.env and replace every CHANGE_ME value.
# Never commit deploy/.env.

COMPOSE_PROJECT_NAME=revint-agent

# Human-readable runtime version labels used for compatibility checks.
N8N_VERSION=2.35.7
POSTGRES_VERSION=16-alpine
NGINX_VERSION=1.31.6
OAUTH2_PROXY_VERSION=7.15.4

# Immutable runtime image references used by Docker Compose.
# Upgrade tooling resolves target tags to immutable digests before deployment.
N8N_IMAGE=docker.io/n8nio/n8n@sha256:166d7e3ca384afdffe75394bf00046c299d84a4bf17b19b35d6cf7773af0a147
POSTGRES_IMAGE=docker.io/library/postgres@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
NGINX_IMAGE=docker.io/library/nginx@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy@sha256:b1b2021fe8f4004573e8d690dec6c7bb29cc44364572cf8510a05bf3a0ae2ded

# n8n application database
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# n8n credential encryption
# Generate a stable random key and keep it backed up securely.
# Changing this key later can make stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME_USE_A_LONG_RANDOM_ENCRYPTION_KEY

# Reporting database administrator
# Stage 2 will add dedicated least-privilege runtime roles.
REPORTING_DB_NAME=revenue_reporting
REPORTING_DB_ADMIN_USER=revint_admin
REPORTING_DB_ADMIN_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Local-only Stage 1 access.
# Production internet exposure will be added only after HTTPS and access controls.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_PROXY_HOPS=1

# Outbound connector DNS. Override with client/VPC DNS when public resolvers
# are not appropriate or internal service discovery is required.
EGRESS_DNS_PRIMARY=1.1.1.1
EGRESS_DNS_SECONDARY=8.8.8.8

# Optional development-only guard for installations that coexist with a
# separate legacy n8n. Real client deployments normally leave this false.
PROTECTED_LEGACY_N8N_PORT=5678
VERIFY_LEGACY_N8N_REQUIRED=false

# HTTPS ingress is safe-by-default and binds to localhost for verification.
# Do not set INGRESS_BIND_ADDRESS=0.0.0.0 until DNS, a trusted certificate,
# firewall rules, and the public webhook URL are ready.
PUBLIC_DOMAIN=localhost
PUBLIC_HTTPS_ORIGIN=https://localhost:8443
INGRESS_BIND_ADDRESS=127.0.0.1
INGRESS_HTTP_PORT=8080
INGRESS_HTTPS_PORT=8443

# Reusable security-gateway resource limits.
REPORT_RATE_LIMIT=60r/m
REPORT_RATE_BURST=20
INGEST_RATE_LIMIT=120r/m
INGEST_RATE_BURST=40
SSO_RATE_LIMIT=60r/m
SSO_RATE_BURST=20
REPORT_MAX_BODY_SIZE=64k
INGEST_MAX_BODY_SIZE=128k
MAX_CONN_PER_IP=20

# External SSO / OIDC.
# Safe default: disabled. Enable only after registering the callback URL
# <PUBLIC_HTTPS_ORIGIN>/oauth2/callback with the chosen identity provider.
SSO_ENABLED=false
SSO_IDENTITY_PROVIDER_KEY=oidc
SSO_OIDC_ISSUER_URL=https://CHANGE_ME_IDENTITY_PROVIDER
SSO_OIDC_CLIENT_ID=CHANGE_ME_OIDC_CLIENT_ID
SSO_OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
SSO_ALLOWED_EMAIL_DOMAINS=CHANGE_ME_ALLOWED_EMAIL_DOMAIN
SSO_COOKIE_SECRET=CHANGE_ME_USE_A_32_BYTE_BASE64_COOKIE_SECRET
# Internal edge-to-n8n credential. Header name: X-Revint-Sso-Internal-Key.
SSO_INTERNAL_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SSO_INTERNAL_KEY

# Client-specific timezone will move to the business configuration layer.
GENERIC_TIMEZONE=Etc/UTC
TZ=Etc/UTC

# Execution retention in hours (14 days by default).
EXECUTIONS_DATA_MAX_AGE=336

# Local Agent v2 backup retention. Backups are written under ./backups by default.
BACKUP_RETENTION_DAYS=14


# Stage 2 least-privilege runtime credentials
REPORTING_DB_READER_USER=revint_agent_reader
REPORTING_DB_READER_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_READER_PASSWORD
AUDIT_DB_WRITER_USER=revint_audit_writer
AUDIT_DB_WRITER_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_AUDIT_PASSWORD

# Stage 2 client business configuration
CLIENT_COMPANY_NAME="CHANGE_ME_CLIENT_NAME"
CLIENT_TIMEZONE=Etc/UTC
CLIENT_CURRENCY=USD
CLIENT_FISCAL_YEAR_START_MONTH=1
CLIENT_STALE_DEAL_DAYS=14
CLIENT_MIN_PIPELINE_COVERAGE=3.0

# Stage 3 least-privilege connector ingestion credential
# This login may execute only the controlled canonical ingestion gateway.
CONNECTOR_DB_WRITER_USER=revint_connector_writer
CONNECTOR_DB_WRITER_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_CONNECTOR_PASSWORD

# Stage 4 authenticated REST ingestion
# Header name is X-Revint-Ingest-Key. Keep the value private.
REST_INGEST_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_INGESTION_KEY

# Agent report API
# Header name is X-Revint-Report-Key. Keep the value private.
REPORT_API_KEY=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_REPORT_API_KEY

# Optional governed Groq intelligence adapter.
# Safe default: disabled. Use a dedicated Agent V2 Groq API key; do not copy
# credentials from another n8n deployment or client.
GROQ_INTENT_ENABLED=false
GROQ_SUMMARY_ENABLED=false
GROQ_API_KEY=CHANGE_ME_USE_A_DEDICATED_GROQ_API_KEY
GROQ_INTENT_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b

# HubSpot incremental Deals connector.
# Safe default: disabled. Use a dedicated HubSpot private-app token with deal-read scope only.
HUBSPOT_SYNC_ENABLED=false
HUBSPOT_PRIVATE_APP_TOKEN=CHANGE_ME_USE_A_PRIVATE_APP_TOKEN
HUBSPOT_INITIAL_LOOKBACK_DAYS=30
HUBSPOT_SYNC_OVERLAP_SECONDS=300

# Salesforce incremental Opportunity connector.
# Safe default: disabled. Create a dedicated Agent V2 Salesforce OAuth credential
# named "REVINT | Salesforce Opportunities RO" with ID REVINTSALESFORCERO001.
# The credential's Salesforce user/profile must be independently confirmed read-only
# for the Opportunity fields used by the connector before activation.
SALESFORCE_SYNC_ENABLED=false
SALESFORCE_READONLY_CONFIRMED=false
SALESFORCE_INSTANCE_URL=https://CHANGE_ME.my.salesforce.com
SALESFORCE_INITIAL_LOOKBACK_DAYS=30
SALESFORCE_SYNC_OVERLAP_SECONDS=300

# Airtable incremental Opportunity connector.
# Safe default: disabled. Use a dedicated read-only PAT where possible.
# The local connector config must contain the verified real field mappings before activation.
AIRTABLE_SYNC_ENABLED=false
AIRTABLE_PERSONAL_ACCESS_TOKEN=CHANGE_ME_DEDICATED_AIRTABLE_PAT
AIRTABLE_BASE_ID=CHANGE_ME_AIRTABLE_BASE_ID
AIRTABLE_TABLE_ID=CHANGE_ME_AIRTABLE_OPPORTUNITIES_TABLE_ID
AIRTABLE_LAST_MODIFIED_FIELD=CHANGE_ME_AIRTABLE_LAST_MODIFIED_FIELD
AIRTABLE_CONNECTOR_CONFIG_FILE=config/connectors.local.json
AIRTABLE_INITIAL_LOOKBACK_DAYS=30
AIRTABLE_SYNC_OVERLAP_SECONDS=300

# Optional governed Slack report delivery. Safe-disabled by default.
SLACK_REPORT_ENABLED=false
SLACK_REPORT_ACCESS_TOKEN=CHANGE_ME_SLACK_BOT_TOKEN

# External incident notifications.
# Separate operational channel/credential from normal manager report delivery.
INCIDENT_SLACK_ENABLED=false
INCIDENT_SLACK_ACCESS_TOKEN=CHANGE_ME_DEDICATED_INCIDENT_SLACK_BOT_TOKEN
INCIDENT_SLACK_CHANNEL_ID=CHANGE_ME_INCIDENT_CHANNEL_ID
INCIDENT_SLACK_CHANNEL_NAME=CHANGE_ME_INCIDENT_CHANNEL_NAME
INCIDENT_MIN_SEVERITY=warning
INCIDENT_COOLDOWN_SECONDS=3600


# Governed Gmail manager-report delivery.
# Safe default: disabled. Create a dedicated n8n Gmail OAuth2 credential:
# ID REVINTGMAILREPORT001, name "REVINT | Gmail Reports".
EMAIL_REPORT_ENABLED=false
EMAIL_REPORT_RECIPIENT=CHANGE_ME_MANAGER_EMAIL
EMAIL_REPORT_RECIPIENT_NAME=CHANGE_ME_MANAGER_NAME
EMAIL_REPORT_MAX_SUBJECT_CHARS=180
EMAIL_REPORT_MAX_BODY_CHARS=20000
