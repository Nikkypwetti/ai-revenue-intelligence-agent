# Agent V2 encrypted off-site backup.
# Copy to deploy/offsite-backup.env (gitignored/private) and replace placeholders.
# Plain database dumps are never sent to the remote.

OFFSITE_BACKUP_ENABLED=false

# age public recipient, for example: age1...
# Keep the matching private identity outside this repository and back it up securely.
AGE_RECIPIENT=CHANGE_ME_AGE_PUBLIC_RECIPIENT

# Existing rclone destination, for example:
# gdrive-secure:revint-agent-v2
# s3-secure:company-backups/revint-agent-v2
RCLONE_REMOTE=CHANGE_ME_RCLONE_REMOTE
